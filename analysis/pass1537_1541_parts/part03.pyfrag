            sign = 1 if image_left == octets[image_index][0] else -1
            signed_octet[image_index, index] = sign
        octet_generators.append(permutation_matrix(tuple(octet_permutation)))
        signed_octet_generators.append(signed_octet)

        edge_action = np.zeros((240, 240), dtype=np.int64)
        signed_edge_action = np.zeros((240, 240), dtype=np.int64)
        for index, (left, right) in enumerate(edges):
            image_left, image_right = generator[left], generator[right]
            target = tuple(sorted((image_left, image_right)))
            image_index = edge_index[target]
            edge_action[image_index, index] = 1
            signed_edge_action[image_index, index] = 1 if image_left < image_right else -1
        edge_generators.append(edge_action)
        signed_edge_generators.append(signed_edge_action)

    return {
        "point_generators": point_generators,
        "group_order": len(group),
        "octet_generators": octet_generators,
        "signed_octet_generators": signed_octet_generators,
        "edge_generators": edge_generators,
        "signed_edge_generators": signed_edge_generators,
    }


def restricted_generators(
    ambient_basis: np.ndarray, ambient_actions: list[np.ndarray], prime: int
) -> list[np.ndarray]:
    left = left_inverse_mod(ambient_basis, prime)
    output = []
    for action in ambient_actions:
        restricted = left @ (action @ ambient_basis) % prime
        if not np.array_equal(ambient_basis @ restricted % prime, action @ ambient_basis % prime):
            raise AssertionError("subspace is not invariant")
        output.append(restricted)
    return output


def module_frontier(data: dict[str, Any], actions: dict[str, Any]) -> tuple[dict[str, Any], dict[str, bool]]:
    K = data["K"].astype(np.int64)
    M = data["M"].astype(np.int64)
    A = data["A"]
    N = data["N"]
    d = data["d"]
    gram = K @ K.T

    gram_2 = gram % 2
    gram_3 = gram % 3
    basis_2 = column_basis_mod(gram_2, 2)
    actions_2 = restricted_generators(basis_2, actions["octet_generators"], 2)
    algebra_2 = algebra_dimension(actions_2, 2)

    projector_numerator = (A - 12 * np.eye(40, dtype=np.int64)) @ (
        A - 2 * np.eye(40, dtype=np.int64)
    )
    signed_turn_bridge = d.T @ projector_numerator @ N // 16
    octet_bridge_2 = K.T @ gram_2 % 2
    mod2_bridge_rank = rank_mod(octet_bridge_2, 2)
    mod2_same_image = rank_mod(
        np.hstack([octet_bridge_2, signed_turn_bridge % 2]), 2
    ) == 14
    mod2_equivariance = all(
        np.array_equal(
            edge_action @ octet_bridge_2 % 2,
            octet_bridge_2 @ octet_action % 2,
        )
        for edge_action, octet_action in zip(
            actions["edge_generators"], actions["octet_generators"]
        )
    )

    ones_45 = np.ones(45, dtype=np.int64)
    basis_3 = extend_basis([ones_45], [gram_3[:, index] for index in range(45)], 3)
    actions_3 = restricted_generators(basis_3, actions["octet_generators"], 3)
    quotient_actions = [action[1:, 1:] % 3 for action in actions_3]
    quotient_algebra = algebra_dimension(quotient_actions, 3)
    fixed_dimension = 15 - rank_mod(
        np.vstack([(action - np.eye(15, dtype=np.int64)) % 3 for action in actions_3]), 3
    )
    dual_fixed = nullspace_mod(
        np.vstack([(action.T - np.eye(15, dtype=np.int64)) % 3 for action in actions_3]), 3
    )
    split_functional_nonzero = dual_fixed.shape == (1, 15) and int(dual_fixed[0, 0]) % 3 != 0

    checks = {
        "Gram_ranks_14_mod2_15_mod3": rank_mod(gram, 2) == 14 and rank_mod(gram, 3) == 15,
        "Gram_square_zero_mod2_mod3": not np.any(gram @ gram % 2) and not np.any(gram @ gram % 3),
        "mod2_image_absolutely_irreducible_14": basis_2.shape == (45, 14) and algebra_2 == 14 * 14,
        "mod2_octet_bridge_rank_14": mod2_bridge_rank == 14,
        "mod2_octet_bridge_equals_pass1416_image": mod2_same_image,
        "mod2_bridge_generator_equivariance": mod2_equivariance,
        "mod3_image_contains_constant_vector": basis_3.shape == (45, 15)
        and np.array_equal(basis_3[:, 0] % 3, ones_45 % 3),
        "mod3_fixed_space_dimension_1": fixed_dimension == 1,
        "mod3_extension_splits": split_functional_nonzero,
        "mod3_quotient_absolutely_irreducible_14": quotient_algebra == 14 * 14,
    }
    result = {
        "Gram_rank_mod2": rank_mod(gram, 2),
        "Gram_rank_mod3": rank_mod(gram, 3),
        "mod2_module": "absolutely irreducible 14",
        "mod2_group_algebra_dimension": algebra_2,
        "mod2_bridge": "im(K^T Gram_2) = im(F_1416 mod 2)",
        "mod3_module": "1 direct-sum absolutely irreducible 14",
        "mod3_fixed_dimension": fixed_dimension,
        "mod3_quotient_group_algebra_dimension": quotient_algebra,
        "mod3_split_functional": [int(x) for x in dual_fixed[0]],
        "prior_art": (
            "Pass 1604 owns the integral Smith data of the earlier C/F bridges. "
            "Pass 1537 adds the equivariant image equality and modular module structure."
        ),
        "boundary": (
            "The mod-3 rank 15 is not a 15-dimensional irreducible: it splits as 1+14. "
            "The mod-2 14 is identified by a literal ambient-edge image equality with Pass 1416."
        ),
    }
    return result, checks


def lattice_frontier(data: dict[str, Any], actions: dict[str, Any]) -> tuple[dict[str, Any], dict[str, bool]]:
    K = data["K"].astype(np.int64)
    A = data["A"]
    S = data["S"]
    U = data["U"]
    d = data["d"]
    d2 = data["d2"]

    left_kernel_3 = nullspace_mod(K.T, 3)
    ones_45 = np.ones(45, dtype=np.int64)
    ones_240 = np.ones(240, dtype=np.int64)
    saturated = np.vstack([K[:-1], ones_240])

    original_pivots = pivot_columns_mod(K, 2)
    original_minor = bareiss_det(K[:, original_pivots])
    saturated_pivots_3 = pivot_columns_mod(saturated, 3)
    saturated_minor = bareiss_det(saturated[:, saturated_pivots_3])

    signed_lift = 4 * U + S @ d
    laplacian_1 = d.T @ d + d2 @ d2.T
    lift_equivariance = all(
        np.array_equal(
            signed_edge @ signed_lift.T,
            signed_lift.T @ signed_octet,
        )
