cover := Set([7, 31, 74, 112, 129, 141, 158, 190, 194, 227, 255, 278, 321]);;
gamma := Graph(Group(()), [1..325], OnPoints,
                function(x,y) return y in adj[x]; end, true);;
aut := AutGroupGraph(gamma);;
stab := Stabilizer(aut, cover, OnSets);;
hom := ActionHomomorphism(stab, cover, OnPoints);;
act := Image(hom);;
orbs := Orbits(act, [1..13]);;
sizes := List(orbs, Length);;
der := DerivedSubgroup(act);;
cen := Centre(act);;
sid := StructureDescription(act);;
repo := GAPInfo.SystemEnvironment.W33_REPO;;
f := OutputTextFile(Concatenation(repo, "/data/_gap_cover_orbits.json"), false);;
SetPrintFormattingStatus(f, false);;
AppendTo(f, "{\n");
AppendTo(f, "  \"image_order\": ", Size(act), ",\n");
AppendTo(f, "  \"orbit_sizes\": ", sizes, ",\n");
AppendTo(f, "  \"n_orbits\": ", Length(orbs), ",\n");
AppendTo(f, "  \"derived_order\": ", Size(der), ",\n");
AppendTo(f, "  \"centre_order\": ", Size(cen), ",\n");
AppendTo(f, "  \"structure\": \"", sid, "\",\n");
AppendTo(f, "  \"is_solvable\": ", IsSolvable(act), "\n");
AppendTo(f, "}\n");
CloseStream(f);;
