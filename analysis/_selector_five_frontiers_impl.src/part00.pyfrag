from pathlib import Path

import numpy as np
import sympy as sp
from sympy.matrices.normalforms import smith_normal_form
from sympy.polys.domains import ZZ

HERE = Path(__file__).resolve().parent
ROOT = HERE.parent
sys.path.insert(0, str(HERE))

from pass1370_1374 import core, modular_radicals
import _mackey_selector_decomposition_impl as mackey_impl
import bt713_selector_sheet_rank_filter as sheet713

GOOD = 1_000_003
DEFAULT_OUT = ROOT / "data" / "w33_pass1390_1394_five_frontiers.json"
WORKERS = ("1390", "1391", "1392", "1393", "1394")

_CAPTURE = None


def sha(payload) -> str:
    return hashlib.sha256(json.dumps(payload, sort_keys=True, separators=(",", ":")).encode()).hexdigest()


def rational_pair(x):
    q = sp.Rational(x)
    return [int(q.p), int(q.q)]


def rational_mod(x, p=GOOD):
    q = sp.Rational(x)
    return int(q.p) * pow(int(q.q), -1, p) % p


def rank_mod(A, p=GOOD):
    A = np.array(A, dtype=np.int64) % p
    m, n = A.shape
    row = 0
    for col in range(n):
        nz = np.flatnonzero(A[row:, col])
        if not len(nz):
            continue
        k = row + int(nz[0])
        A[[row, k]] = A[[k, row]]
        A[row] = A[row] * pow(int(A[row, col]), -1, p) % p
        for i in range(m):
            if i != row and A[i, col]:
                A[i] = (A[i] - int(A[i, col]) * A[row]) % p
        row += 1
        if row == m:
            break
    return row


