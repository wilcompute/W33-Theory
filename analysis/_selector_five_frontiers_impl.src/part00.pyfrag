#!/usr/bin/env python3
"""Passes 1390--1394: five exact continuations of the selector Mackey release.

Workers:
  1390  modular Mackey/localization boundary and exact Loewy comparison
  1391  intrinsic 1+2 / square-norm classification of the six dual orbits
  1392  exact rational selector isotypic Fourier transform
  1393  hinge-selected apartment bridge from selectors to Levi Steinberg-81
  1394  integral orbital order, maximal matrix-unit order, discriminant/conductor

The script imports only already-frozen exact repository machinery.  The Mackey
implementation is observed through Python's return trace so its exact internal
projectors can be reused without changing the verified Pass-1380--1384 source.
"""
from __future__ import annotations

import argparse
import collections
import hashlib
import itertools
import json
import math
import os
