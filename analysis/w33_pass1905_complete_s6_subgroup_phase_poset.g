# Complete all conjugacy classes of subgroups of the exceptional S6 separator.
OUT := "data/w33_pass1905_complete_s6_subgroup_phase_poset.json";;
G := SymmetricGroup(6);; classesG := ConjugacyClasses(G);;
CycleKey := function(g) local used,out,i,j,n; used:=[];;out:=[];;for i in [1..6] do if not i in used then j:=i;;n:=0;;while not j in used do Add(used,j);n:=n+1;j:=j^g;od;Add(out,n);fi;od;Sort(out,function(a,b)return a>b;end);return JoinStringsWithSeparator(List(out,String),",");end;;
vals24:=rec(k111111:=24,k21111:=4,k2211:=0,k222:=4,k3111:=0,k321:=-2,k33:=3,k411:=0,k42:=0,k51:=-1,k6:=1);;
vals90:=rec(k111111:=90,k21111:=0,k2211:=-6,k222:=0,k3111:=0,k321:=0,k33:=0,k411:=0,k42:=2,k51:=0,k6:=0);;
vals114:=rec(k111111:=114,k21111:=4,k2211:=-6,k222:=4,k3111:=0,k321:=-2,k33:=3,k411:=0,k42:=2,k51:=-1,k6:=1);;
FieldName:=function(k) if k="1,1,1,1,1,1" then return "k111111";elif k="2,1,1,1,1" then return "k21111";elif k="2,2,1,1" then return "k2211";elif k="2,2,2" then return "k222";elif k="3,1,1,1" then return "k3111";elif k="3,2,1" then return "k321";elif k="3,3" then return "k33";elif k="4,1,1" then return "k411";elif k="4,2" then return "k42";elif k="5,1" then return "k51";elif k="6" then return "k6";fi;Error("unknown cycle key");end;;
ValueOn:=function(vals,g)return vals.(FieldName(CycleKey(g)));end;;
AdmitsJ:=function(H,vals)local tbl,irr,reps,chi,mult,indicators,i;tbl:=CharacterTable(H);;irr:=Irr(tbl);;reps:=List(ConjugacyClasses(H),Representative);;chi:=ClassFunction(tbl,List(reps,g->ValueOn(vals,g)));;indicators:=Indicator(tbl,irr,2);;for i in [1..Length(irr)] do mult:=ScalarProduct(chi,irr[i]);;if indicators[i]=1 and mult mod 2<>0 then return false;fi;od;return true;end;;
JsonBool:=b->(if b then return "true";else return "false";fi);;
cc:=ConjugacyClassesSubgroups(G);;rows:=[];;for c in cc do H:=Representative(c);;Add(rows,rec(order:=Size(H),structure:=StructureDescription(H),j24:=AdmitsJ(H,vals24),j90:=AdmitsJ(H,vals90),j114:=AdmitsJ(H,vals114)));;od;
s:=OutputTextFile(OUT,false);;SetPrintFormattingStatus(s,false);;WriteAll(s,"{\"schema\":\"w33.pass1905.complete_s6_subgroup_phase_poset.gap.v1\",\"status\":\"PASS\",\"subgroup_class_count\":");;WriteAll(s,String(Length(rows)));;WriteAll(s,",\"rows\":[");;for i in [1..Length(rows)] do r:=rows[i];if i>1 then WriteAll(s,",");fi;WriteAll(s,Concatenation("{\"order\":",String(r.order),",\"structure\":\"",r.structure,"\",\"j24\":",JsonBool(r.j24),",\"j90\":",JsonBool(r.j90),",\"j114\":",JsonBool(r.j114),",\"pairedV9\":true}"));od;WriteAll(s,"],\"criterion\":\"Every FS=+1 irreducible multiplicity is even; FS=0 and FS=-1 blocks already carry commuting complex structures.\"}\n");;CloseStream(s);;Print("Pass 1905 complete S6 subgroup phase poset: PASS, classes=",Length(rows),"\n");
