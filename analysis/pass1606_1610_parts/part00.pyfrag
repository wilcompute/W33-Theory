class BitBasis:
    """Incremental exact GF(2) row basis using Python integers."""
    def __init__(self):
        self.pivots = {}
    def add_indices(self, indices):
        x = 0
        for i in indices:
            x ^= 1 << int(i)
        return self.add_int(x)
    def add_array(self, row):
        nz = np.flatnonzero(np.asarray(row, dtype=np.uint8) & 1)
        return self.add_indices(nz)
    def add_int(self, x):
        while x:
            p = x.bit_length() - 1
            if p in self.pivots:
                x ^= self.pivots[p]
            else:
                self.pivots[p] = x
                return True
        return False
    @property
    def rank(self):
        return len(self.pivots)


def normalize(v: Iterable[int]):
    v = tuple(int(x) % Q for x in v)
    if not any(v):
        return None
    for x in v:
        if x:
            inv = 1 if x == 1 else 2
            return tuple((inv * y) % Q for y in v)


def symplectic(u, v) -> int:
    return int((np.array(u, dtype=np.int64) @ OMEGA @ np.array(v, dtype=np.int64)) % Q)


def compose(p, q):
    return tuple(p[q[i]] for i in range(len(p)))


def invperm(p):
    out = [0] * len(p)
    for i, j in enumerate(p):
        out[j] = i
    return tuple(out)


def generated_group(gens):
    identity = tuple(range(len(gens[0])))
    gens = list(gens) + [invperm(g) for g in gens]
