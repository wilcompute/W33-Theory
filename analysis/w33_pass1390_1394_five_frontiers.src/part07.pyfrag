    start = 0
    for block in blocks:
        E = block["E"]
        local = [E[i][j] for i in range(len(E)) for j in range(len(E))]
        cols.extend(local)
        block_slices.append((start, start + len(local), int(block["n"])))
        start += len(local)
    assert start == 83
    return sp.Matrix.hstack(*cols), block_slices


def worker_1394():
    public, cap = capture_mackey()
    g = cap["g"]
    blocks = core.matrix_units_full(g, cap["full_records"])
    C, slices = flatten_matrix_units(blocks)  # maximal matrix-unit basis in orbital coordinates
    assert C.shape == (83, 83) and C.det() != 0
    B = C.inv()  # orbital basis expressed in matrix-unit coordinates
    nonintegral = [(i, j, B[i, j]) for i in range(83) for j in range(83) if sp.Rational(B[i, j]).q != 1]
    assert not nonintegral
    Bz = sp.Matrix([[int(B[i, j]) for j in range(83)] for i in range(83)])

    detB = abs(int(Bz.det(method="domain-ge")))
    assert detB > 0
    det_factor = factor_dict(detB)
    assert set(det_factor).issubset({"2", "3"})

    # Smith factors of M/O, with O the orbital order and M the split matrix-unit maximal order.
    S = smith_normal_form(Bz, domain=ZZ)
    smith = [abs(int(S[i, i])) for i in range(83)]
    assert math.prod(smith) == detB
    smith_census = {str(k): v for k, v in sorted(collections.Counter(smith).items())}

    conductor = []
    conductor_index = 1
    for bi, (start, stop, n) in enumerate(slices):
        level = 1
        for j in range(start, stop):
            level = math.lcm(level, denominator_lcm(C[:, j]))
        conductor.append({"block": bi, "matrix_size": n, "level": level, "level_factorization": factor_dict(level)})
        conductor_index *= level ** (n * n)
    assert all(item["level"] % 5 for item in conductor)

    # Reduced-trace Gram determinant check. In matrix-unit coordinates the Gram pairs E_ij with E_ji.
    Gm = sp.zeros(83)
    cursor = 0
    for _start, _stop, n in slices:
        for i in range(n):
            for j in range(n):
                a = cursor + i * n + j
                b = cursor + j * n + i
                Gm[a, b] = 1
        cursor += n * n
    Gram = Bz.T * Gm * Bz
    disc = abs(int(Gram.det(method="domain-ge")))
    assert disc == detB * detB

    result = {
        "theorem": "Pass 1394 Integral Orbital Order and Discriminant",
        "orbital_order": "O = Z-span of the 83 stabilizer orbitals",
        "maximal_order": "M = Z^7 + M2(Z)^2 + M3(Z)^3 + M4(Z) + M5(Z), generated by the exact rational matrix units",
        "orbital_order_contained_in_maximal_order": True,
        "index_M_over_O": str(detB),
        "index_factorization": det_factor,
        "reduced_trace_discriminant": str(disc),
        "discriminant_factorization": factor_dict(disc),
        "discriminant_equals_index_squared": True,
        "smith_invariant_factor_census": smith_census,
        "nontrivial_smith_factors": [x for x in smith if x != 1],
        "conductor_levels_by_rational_block": conductor,
        "conductor_index_in_M": str(conductor_index),
        "local_maximality": {
            "2": all(x % 2 for x in smith),
            "3": all(x % 3 for x in smith),
            "5": all(x % 5 for x in smith),
        },
        "conclusion": "The integral orbital basis is an explicit suborder of the split matrix-unit maximal order. Its index, Smith quotient, reduced-trace discriminant, and blockwise conductor are exact; only 2 and 3 obstruct local maximality, while the order is maximal at 5.",
        "boundary": "The maximal order is the one selected by the frozen rational matrix units. Conductor levels are blockwise two-sided levels inside that split maximal order.",
    }
    assert result["local_maximality"] == {"2": False, "3": False, "5": True}
