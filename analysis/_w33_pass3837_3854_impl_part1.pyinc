#!/usr/bin/env python3
"""Passes 3837-3854 exact ovoid/Wedderburn/code/Leech/axial/triality closure.

This verifier exposes the already published Passes 3795-3812 executable
substrate and derives five queued fronts plus three additional constructions.
Monster/mmgroup words and class fusion remain fail-closed unless a populated
candidate passes the separate strict harness.
"""
from __future__ import annotations

import argparse
import gc
from collections import Counter, deque
from fractions import Fraction
from hashlib import sha256
from itertools import combinations
import json
from math import lcm
from pathlib import Path

import networkx as nx
import numpy as np
import sympy as sp

ROOT = Path(__file__).resolve().parents[1] if Path(__file__).resolve().parent.name == "analysis" else Path(__file__).resolve().parent
DEFAULT_OUTPUT = ROOT / "data" / "PART_3837_3854_OVOID_WEDDERBURN_CODE_LEECH_TRIALITY_results.json"
MOD = 1_000_003


def compose(a, b):
    return tuple(a[b[i]] for i in range(len(a)))


def inverse(a):
    out = [0] * len(a)
    for i, j in enumerate(a):
        out[j] = i
    return tuple(out)


def perm_order(g):
    seen = set()
    answer = 1
    for i in range(len(g)):
        if i in seen:
            continue
        j, n = i, 0
        while j not in seen:
            seen.add(j)
            j = g[j]
            n += 1
        answer = lcm(answer, n)
    return answer


def rank_mod(matrix, p=MOD):
    a = np.asarray(matrix, dtype=np.int64).copy() % p
    rank = 0
    for col in range(a.shape[1]):
        candidates = np.flatnonzero(a[rank:, col])
        if len(candidates) == 0:
            continue
        pivot = rank + int(candidates[0])
        if pivot != rank:
            a[[rank, pivot]] = a[[pivot, rank]]
        a[rank] = a[rank] * pow(int(a[rank, col]), -1, p) % p
        for row in np.flatnonzero(a[:, col]):
            if row != rank:
                a[row] = (a[row] - a[row, col] * a[rank]) % p
        rank += 1
        if rank == a.shape[0]:
            break
    return rank


class IncrementalBasis:
    def __init__(self, p=MOD):
        self.p = p
        self.rows = []
        self.pivots = []

    def add(self, vector):
        v = np.asarray(vector, dtype=np.int64).copy() % self.p
        for row, pivot in zip(self.rows, self.pivots):
            if v[pivot]:
                v = (v - v[pivot] * row) % self.p
        nz = np.flatnonzero(v)
        if len(nz) == 0:
            return False
        pivot = int(nz[0])
        v = v * pow(int(v[pivot]), -1, self.p) % self.p
        for i, row in enumerate(self.rows):
            if row[pivot]:
                self.rows[i] = (row - row[pivot] * v) % self.p
        pos = int(np.searchsorted(self.pivots, pivot))
        self.pivots.insert(pos, pivot)
        self.rows.insert(pos, v)
        return True


def expose_previous_build():
    parts = [ROOT / "analysis" / f"_w33_pass3795_3812_impl_part{i}.pyinc" for i in range(1, 5)]
    if all(path.exists() for path in parts):
        source = "".join(path.read_text(encoding="utf-8") for path in parts)
        source_name = str(parts[0])
    else:
        candidates = [
            ROOT / "w33_pass3795_3812_plane_ovoid_scheme_leech_axial.py",
            ROOT / "analysis" / "w33_pass3795_3812_plane_ovoid_scheme_leech_axial_full.py",
        ]
        path = next(path for path in candidates if path.exists())
        source = path.read_text(encoding="utf-8")
        source_name = str(path)
    old = "    return result\n\n\ndef main():"
    new = "    return result, locals()\n\n\ndef main():"
    assert source.count(old) == 1
    namespace = {"__name__": "w33_pass3795_exposed", "__file__": source_name}
    exec(compile(source.replace(old, new), source_name, "exec"), namespace)
    return namespace["build"]()


def polar(x, y):
    a = tuple((x >> i) & 1 for i in range(6))
    b = tuple((y >> i) & 1 for i in range(6))
    return (a[0]*b[1] + a[1]*b[0] + a[2]*b[3] + a[3]*b[2] + a[4]*b[5] + a[5]*b[4]) & 1


def symmetry(v, x):
    return x ^ (v if polar(x, v) else 0)


def orbit_partition(product_set, generator_pairs):
    remaining = set(product_set)
    orbits = []
    while remaining:
        seed = min(remaining)
        queue = deque([seed])
        remaining.remove(seed)
        orbit = []
        while queue:
            a, b = queue.popleft()
            orbit.append((a, b))
            for ga, gb in generator_pairs:
                image = (ga[a], gb[b])
                if image in remaining:
                    remaining.remove(image)
                    queue.append(image)
        orbits.append(tuple(sorted(orbit)))
    return tuple(sorted(orbits, key=lambda o: (len(o), o[0])))



def fraction_string(x):
    x = Fraction(x)
    return str(x.numerator) if x.denominator == 1 else f"{x.numerator}/{x.denominator}"
