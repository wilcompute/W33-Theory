SimplexTrace := function(x,L) local s,img,p,total; total:=0; for s in L do img:=List(s,a->a^x); if Set(img)=Set(s) then p:=PermList(List(img,a->Position(s,a))); total:=total+SignPerm(p); fi; od; return total; end;;
cl := ConjugacyClasses(G);; reps:=List(cl,Representative);; sizes:=List(cl,Size);; ords:=List(reps,Order);;
c0:=List(reps,x->Number([1..40],a->a^x=a));; c1:=List(reps,x->SimplexTrace(x,edges));; c2:=List(reps,x->SimplexTrace(x,tris));; c3:=List(reps,x->SimplexTrace(x,tets));;
tbl:=CharacterTable(G);; Print("NCL ",NrConjugacyClasses(tbl),"\n"); Print("SIZESEQ ",sizes,"\n"); Print("TSIZE ",SizesConjugacyClasses(tbl),"\n"); Print("ORDSEQ ",ords,"\n"); Print("TORD ",OrdersClassRepresentatives(tbl),"\n");
if sizes<>SizesConjugacyClasses(tbl) or ords<>OrdersClassRepresentatives(tbl) then Error("class order mismatch"); fi;
irr:=Irr(tbl);; deg:=List(irr,x->x[1]);; Print("DEG ",deg,"\n");
cf0:=ClassFunction(tbl,c0);; cf1:=ClassFunction(tbl,c1);; cf2:=ClassFunction(tbl,c2);; cf3:=ClassFunction(tbl,c3);;
one:=Irr(tbl)[1];; st:=one-cf0+cf1-cf2+cf3;; m120:=cf2-cf3;;
Decomp := function(cf) return List(irr,x->ScalarProduct(cf,x)); end;;
Print("C0 ",c0,"\nC1 ",c1,"\nC2 ",c2,"\nC3 ",c3,"\n");
Print("DEC0 ",Decomp(cf0),"\nDEC1 ",Decomp(cf1),"\nDEC2 ",Decomp(cf2),"\nDEC3 ",Decomp(cf3),"\n");
Print("DECST ",Decomp(st),"\nDECM120 ",Decomp(m120),"\n");QUIT;
