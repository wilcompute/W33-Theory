import Mathlib

namespace W33.Pass11858

/-!
Pass 11858: the `A₅` root lattice mod 3 as a module for the finite Lorentz group `A₆` (Passes 11844, 11850).

Model: `S = {x ∈ (ZMod 3)⁶ | Σ xᵢ = 0}` (the sum-zero lattice mod 3), with `A₆` permuting coordinates (generated by the
3-cycles `(0 1 2), (0 1 3), (0 1 4), (0 1 5)`), and the quadratic form `Q(x) = (x, x)/2 = 2 Σ xᵢ² (mod 3)`.

* The all-ones vector lies in `S`, is fixed by `A₆`, and is the radical: `Q(x + c·1) = Q(x)` on `S`.
* The nonzero vectors of `S` split `62 + 90 + 90` by `Q = 0, 1, 2`, i.e. `2` (the radical line) `+ 20·3 + 30·3 + 30·3`:
  the quotient `S/⟨1⟩` carries the Minkowski orbits `20 + 30 + 30` of Pass 11833.
* **No invariant hyperplane.**  A linear functional `x ↦ Σ aᵢ xᵢ` restricted to `S` is invariant under a generator `σ`
  iff `a ∘ σ⁻¹ - a` is constant (the annihilator of `S` is `⟨1⟩`).  The only coefficient vectors invariant in this sense
  under all four generators are constant, i.e. vanish on `S`.  Since `A₆` is perfect, a 4-dim invariant subspace `W ⊂ S`
  would give a nonzero invariant functional on `S` vanishing on `W`; so **`S` has no `A₆`-invariant 4-dim subspace** and
  the Minkowski translations occur only as the non-split extension `ℤ₃ · M`.
-/

abbrev V := Fin 6 → ZMod 3

def inS (x : V) : Prop := ∑ i, x i = 0

instance : DecidablePred inS := fun x => inferInstanceAs (Decidable (∑ i, x i = 0))

def Q (x : V) : ZMod 3 := 2 * ∑ i, x i ^ 2

def one : V := fun _ => 1

/-- The four generating 3-cycles of `A₆`, as permutations of the coordinates. -/
def c3 (k : Fin 6) : Fin 6 → Fin 6 := fun i =>
  if i = 0 then 1 else if i = 1 then k else if i = k then 0 else i

def act (σ : Fin 6 → Fin 6) (a : V) : V := fun i => a (σ i)

theorem one_in_S : inS one := by decide

theorem one_fixed : ∀ k ∈ ({2, 3, 4, 5} : Finset (Fin 6)), act (c3 k) one = one := by decide

set_option maxRecDepth 200000 in
theorem radical : ∀ x : V, inS x → ∀ c : ZMod 3, Q (x + c • one) = Q x := by decide

set_option maxRecDepth 200000 in
theorem counts :
    (Finset.univ.filter (fun x : V => inS x ∧ x ≠ 0 ∧ Q x = 0)).card = 62 ∧
    (Finset.univ.filter (fun x : V => inS x ∧ Q x = 1)).card = 90 ∧
    (Finset.univ.filter (fun x : V => inS x ∧ Q x = 2)).card = 90 := by decide

/-- A coefficient vector `a` defines an invariant functional on `S` for the generator `σ` iff `a ∘ σ - a` is constant. -/
def invariantFor (σ : Fin 6 → Fin 6) (a : V) : Prop := ∃ c : ZMod 3, ∀ i, a (σ i) - a i = c

instance (σ : Fin 6 → Fin 6) : DecidablePred (invariantFor σ) := fun a =>
  inferInstanceAs (Decidable (∃ c : ZMod 3, ∀ i, a (σ i) - a i = c))

set_option maxRecDepth 200000 in
/-- No nonzero `A₆`-invariant functional on `S`: invariance under all four 3-cycles forces `a` constant. -/
theorem no_invariant_functional :
    ∀ a : V, (invariantFor (c3 2) a ∧ invariantFor (c3 3) a ∧ invariantFor (c3 4) a ∧ invariantFor (c3 5) a) →
      ∃ c : ZMod 3, ∀ i, a i = c := by
  decide

end W33.Pass11858
