import W33.Pass575CyclotomicDVRKernel
import Mathlib.RingTheory.AdicCompletion.LocalRing

/-!
# Pass 581: residue-field quotient and the λ-adic completion

The preceding files construct the fifth-cyclotomic integral order and prove that
its residue kernel is the principal ideal generated by `lambdaBar`.  This file
turns that equality into an explicit first-isomorphism equivalence with `ZMod 5`
and defines the corresponding adic completion.

The completion is now a native Mathlib object.  Proving that the original order
is local/Noetherian in the precise form required by the generic completion
instances, and deriving the normalized DVR valuation and ramification index,
remain explicit downstream obligations.
-/

namespace W33.Pass581

open W33.Pass570 W33.Pass575

noncomputable section

/-- The principal ideal generated by the cyclotomic uniformizer. -/
abbrev uniformizerIdeal : Ideal CyclotomicFiveOrder :=
  Ideal.span ({lambdaBar} : Set CyclotomicFiveOrder)

/-- The residue quotient is canonically the field with five elements. -/
noncomputable def residueQuotientEquiv :
    CyclotomicFiveOrder ⧸ uniformizerIdeal ≃+* ZMod 5 :=
  (Ideal.quotEquivOfEq residueIdeal_eq_lambda_span.symm).trans
    (RingHom.quotientKerEquivOfSurjective residueMap_surjective)

@[simp]
theorem residueQuotientEquiv_mk (x : CyclotomicFiveOrder) :
    residueQuotientEquiv ((Ideal.Quotient.mk uniformizerIdeal) x) = residueMap x := by
  -- The composite is definitionally `residueMap x`: `quotEquivOfEq` and
  -- `kerLift` both reduce on `Ideal.Quotient.mk`.  The previous
  -- `simp [residueQuotientEquiv, uniformizerIdeal]` stalled one step short.
  rfl

/-- The native λ-adic completion of the fifth-cyclotomic integral order. -/
abbrev CyclotomicFiveAdicCompletion :=
  AdicCompletion uniformizerIdeal CyclotomicFiveOrder

/-- The algebra map into the native completion. -/
noncomputable def completionMap :
    CyclotomicFiveOrder →+* CyclotomicFiveAdicCompletion :=
  algebraMap CyclotomicFiveOrder CyclotomicFiveAdicCompletion

/-- The image of the distinguished uniformizer in the completion. -/
noncomputable def completedLambda : CyclotomicFiveAdicCompletion :=
  completionMap lambdaBar

/-- Remaining theorem boundary after constructing the quotient and completion. -/
structure CompletionTheoremBoundary where
  order_is_local : Prop
  order_is_noetherian : Prop
  completion_is_dvr : Prop
  normalized_value_lambda : Prop
  ramification_index_four : Prop
  residue_degree_one : Prop

end

end W33.Pass581
