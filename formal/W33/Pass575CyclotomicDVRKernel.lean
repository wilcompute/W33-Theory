import W33.Pass570CyclotomicResidue

/-!
# Pass 575: the cyclotomic residue kernel is generated by the uniformizer

This module closes the order-level kernel obligation left explicit in Pass 570.
The proof is algebraic: the defining quartic relation makes `5` a multiple of
`lambdaBar`, and `Polynomial.divX` separates every representative into its
constant term and an `X`-multiple.

The 5-adic completion, completeness, and DVR structure remain separate tasks.
-/

namespace W33.Pass575

open Polynomial
open W33.Pass570

noncomputable section

/-- The defining quartic relation expresses five as a multiple of `lambdaBar`. -/
theorem five_eq_lambda_mul :
    AdjoinRoot.of shiftedPhiFive 5 =
      lambdaBar *
        (-lambdaBar ^ 3 + 5 * lambdaBar ^ 2 - 10 * lambdaBar + 10) := by
  have hroot := AdjoinRoot.eval₂_root shiftedPhiFive
  have hquartic :
      lambdaBar ^ 4 - 5 * lambdaBar ^ 3 + 10 * lambdaBar ^ 2 -
          10 * lambdaBar + 5 = 0 := by
    simpa [shiftedPhiFive, lambdaBar] using hroot
  linear_combination -hquartic

/-- Five already belongs to the principal ideal generated by the uniformizer. -/
theorem five_mem_lambda_span :
    AdjoinRoot.of shiftedPhiFive 5 ∈
      Ideal.span ({lambdaBar} : Set CyclotomicFiveOrder) := by
  rw [Ideal.mem_span_singleton]
  refine ⟨-lambdaBar ^ 3 + 5 * lambdaBar ^ 2 - 10 * lambdaBar + 10, ?_⟩
  exact five_eq_lambda_mul.symm

/-- A polynomial representative whose residue is zero is divisible by the
uniformizer in the adjoined-root order. -/
theorem mk_mem_lambda_span_of_residue_zero
    (p : ℤ[X])
    (hp : residueMap ((AdjoinRoot.mk shiftedPhiFive) p) = 0) :
    (AdjoinRoot.mk shiftedPhiFive) p ∈
      Ideal.span ({lambdaBar} : Set CyclotomicFiveOrder) := by
  have hconstZ : ((p.coeff 0 : ℤ) : ZMod 5) = 0 := by
    simpa [residueMap, Polynomial.eval₂_at_zero] using hp
  have hdiv : (5 : ℤ) ∣ p.coeff 0 :=
    (ZMod.intCast_zmod_eq_zero_iff_dvd (p.coeff 0) 5).mp hconstZ
  rcases hdiv with ⟨q, hq⟩
  rw [Ideal.mem_span_singleton]
  refine ⟨(AdjoinRoot.mk shiftedPhiFive) p.divX +
      (AdjoinRoot.of shiftedPhiFive q) *
        (-lambdaBar ^ 3 + 5 * lambdaBar ^ 2 - 10 * lambdaBar + 10), ?_⟩
  have hpdiv := congrArg (AdjoinRoot.mk shiftedPhiFive)
    (Polynomial.divX_mul_X_add p)
  simp only [map_add, map_mul, AdjoinRoot.mk_X, AdjoinRoot.mk_C] at hpdiv
  rw [← hpdiv, hq, map_mul, five_eq_lambda_mul]
  ring

/-- The residue kernel is exactly the principal uniformizer ideal. -/
theorem residueIdeal_eq_lambda_span :
    residueIdeal = Ideal.span ({lambdaBar} : Set CyclotomicFiveOrder) := by
  apply le_antisymm
  · intro x hx
    rcases AdjoinRoot.mk_surjective x with ⟨p, rfl⟩
    exact mk_mem_lambda_span_of_residue_zero p hx
  · exact lambda_span_le_residueIdeal

/-- Order-level local-ring certificate: the residue map is onto `F_5` and its
kernel is generated by `lambdaBar`. -/
structure OrderLocalCertificate where
  residue_surjective : Function.Surjective residueMap
  kernel_principal : residueIdeal =
    Ideal.span ({lambdaBar} : Set CyclotomicFiveOrder)

/-- The completed order-level certificate. -/
def orderLocalCertificate : OrderLocalCertificate where
  residue_surjective := residueMap_surjective
  kernel_principal := residueIdeal_eq_lambda_span

end

end W33.Pass575
