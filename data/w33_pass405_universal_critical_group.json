  "theorem": {
    "odd_prime_to_p": "for odd ell|p-1: (Z/ell^v_ell(p-1))^(p(p^2-1)/2); for odd ell|p+1: (Z/ell^v_ell(p+1))^(p(p-1)^2/2)",
