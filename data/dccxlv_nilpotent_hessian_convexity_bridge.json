  "bridge_claim": {
    "exact_layer": "The nilpotent action has an exact finite Hessian kernel A''(z), generated by the same resolvent-transfer chain; at z=1 it is a nonnegative upper-triangular kernel supported from the second superdiagonal upward.",
    "conditional_layer": "Interpreting this finite Hessian as continuum convexity/second variation data requires an additional scaling limit."
  },
  "identities": {
    "second_variation_equals_resolvent_generator_derivative_chain": true,
    "entries_match_closed_form_at_z1": true,
    "hessian_has_zero_diagonal_and_first_superdiagonal": true,
    "hessian_is_strictly_upper_triangular": true,
    "trace_of_hessian_is_zero": true,
    "higher_superdiagonals_are_nonnegative": true,
    "first_nontrivial_hessian_entry_is_one_over_four": true,
    "maximal_hessian_entry_is_one_eighth": true
  }
}