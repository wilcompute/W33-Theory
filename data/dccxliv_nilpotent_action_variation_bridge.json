  "bridge_claim": {
    "exact_layer": "The nilpotent logarithm action has an exact variation law dA/dz = R(z)G = GR(z); its derivative is a strictly upper-triangular geometric kernel and its stationarity gap vanishes identically.",
    "conditional_layer": "Interpreting this finite variation law as a continuum Euler-Lagrange equation requires an additional scaling limit."
  },
  "identities": {
    "variation_equals_resolvent_times_generator": true,
    "entries_match_closed_form_at_z1": true,
    "derivative_is_strictly_upper_triangular": true,
    "trace_of_derivative_is_zero": true,
    "variation_commutes_with_generator_chain": true,
    "stationarity_gap_vanishes_exactly": true,
    "action_entries_integrate_derivative_entries": true
  }
}