{"boundary":"This identifies an exact semisimple adjacency-algebra mechanism. It is deliberately not rebranded as a graph isomorphism, a Godsil-McKay switch, or a local edge trade.","central_character_classes":{"exchange_multiplier":2,"nonsquare":[2,3],"square":[1,4]},"checks":{"exact_norm_is_pass456_degree10_factor":true,"exact_square_nonsquare_sheet_exchange":true,"genuine_pair_still_affine_inequivalent":true,"quintics_are_sqrt5_conjugates":true,"regular_multiplicity_five_divides_moments":true,"rendered_quintics_match_closed_forms":true,"twelve_inverse_pairs":true,"unswapped_sheets_separate_at_trace_cube":true},"collision_offsets":{"A":[0,3,4,1,1,0,2,0,1,1,2,2],"B":[0,2,3,0,2,2,4,1,0,3,3,2]},"exact_trace_moments_25d_basis_1_z_z2_z3":{"A":{"1":[[0,0,0,0],[600,0,0,0],[-75,0,-375,-375],[30300,0,1000,1000],[-5525,0,-36250,-36250]],"2":[[0,0,0,0],[600,0,0,0],[300,0,375,375],[29300,0,-1000,-1000],[30725,0,36250,36250]],"3":[[0,0,0,0],[600,0,0,0],[300,0,375,375],[29300,0,-1000,-1000],[30725,0,36250,36250]],"4":[[0,0,0,0],[600,0,0,0],[-75,0,-375,-375],[30300,0,1000,1000],[-5525,0,-36250,-36250]]},"B":{"1":[[0,0,0,0],[600,0,0,0],[300,0,375,375],[29300,0,-1000,-1000],[30725,0,36250,36250]],"2":[[0,0,0,0],[600,0,0,0],[-75,0,-375,-375],[30300,0,1000,1000],[-5525,0,-36250,-36250]],"3":[[0,0,0,0],[600,0,0,0],[-75,0,-375,-375],[30300,0,1000,1000],[-5525,0,-36250,-36250]],"4":[[0,0,0,0],[600,0,0,0],[300,0,375,375],[29300,0,-1000,-1000],[30725,0,36250,36250]]}},"faithful_quintic_factors":{"A_assignment":{"nonsquare":"P_minus_sqrt5","square":"P_plus_sqrt5"},"B_assignment":{"nonsquare":"P_plus_sqrt5","square":"P_minus_sqrt5"},"P_minus_sqrt5":"-25*r + x**5 - 60*x**3 - x**2*(15 - 25*r)/2 + x*(310 - 25*r) - 54","P_plus_sqrt5":"25*r + x**5 - 60*x**3 - x**2*(25*r + 15)/2 + x*(25*r + 310) - 54","norm_to_Q":"x**10 - 120*x**8 - 15*x**7 + 4220*x**6 + 792*x**5 - 37925*x**4 + 4955*x**3 + 96910*x**2 - 39730*x - 209"},"schema":"w33.pass463.q5.central_sheet_exchange.v1","status":"PASS","theorem":