  "exact_graph_adjacency_spectrum": "+(q+1)^1, -(q+1)^1, +sqrt(2q)^mr, -sqrt(2q)^mr, 0^(2ms), where mr=q(q+1)^2/2, ms=q(q^2+1)/2",
  "normalized_graph_laplacian": "L=I-A/(q+1)",
