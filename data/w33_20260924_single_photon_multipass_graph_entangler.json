  "theorem": {
    "setup": "one |+> qutrit ancilla visits memories R1,...,R_2n via the same fixed E_AR, then is measured in Z",
    "branch": "K_m=(1/sqrt(3)) X_frame(m) F^(tensor 2n) D_G, where D_G is a weighted qutrit graph-phase Clifford",
    "phase_law": "q_m(r)=sum_{j=1}^n a_j r_(2j) - m a_n mod 3, a_j=sum_{h=1}^j (-1)^(j-h) r_(2h-1)",
    "graph_edges": "edge (2h-1,2j) has weight (-1)^(j-h) mod 3 for 1<=h<=j<=n",
    "edge_count": "n(n+1)/2",
    "outcome_probability": "1/3 independent of the memory input",
    "odd_sweep_boundary": "An odd number of visited memories does not yield a full-rank unitary branch under the same final computational measurement."
  },
